# ============================================
# Spring Boot Environment Variables
# ============================================
# This file is a template for environment variables used in development.
# Copy this file to .env.dev and fill in your actual values.
# The .env.dev file is loaded automatically when running with the 'dev' profile.

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=figma_plugin
DB_USERNAME=postgres
DB_PASSWORD=password

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_MAX_POOL_SIZE=50
REDIS_MAX_WAITING=100
REDIS_LOG_LEVEL=INFO

# ============================================
# Application Server Configuration
# ============================================
API_PORT=8003
API_HOST=0.0.0.0

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
WEBSOCKET_LOG_LEVEL=INFO

# ============================================
# OpenAI Configuration
# ============================================
# Required for AI agent response generation
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_PROJECT_ID=your-project-id
OPENAI_ORG_ID=your-org-id

# ============================================
# Fireworks AI Configuration
# ============================================
# Required for audio transcription
FIREWORKS_API_KEY=your-fireworks-api-key-here
FIREWORKS_API_BASE_URL=https://api.fireworks.ai
FIREWORKS_WHISPER_MODEL=whisper-v3-large

# ============================================
# Figma Design AI Agent Configuration
# ============================================
# Select AI provider: openai, anthropic, or gemini
FIGMA_DESIGN_PROVIDER=openai

# OpenAI Configuration for Figma Design Agent
FIGMA_DESIGN_OPENAI_MODEL=gpt-4
FIGMA_DESIGN_OPENAI_REASONING_EFFORT=medium
FIGMA_DESIGN_OPENAI_RETURN_THINKING=true
# Optional: FIGMA_DESIGN_OPENAI_TEMPERATURE=
# Optional: FIGMA_DESIGN_OPENAI_MAX_TOKENS=

# Anthropic Configuration for Figma Design Agent
ANTHROPIC_API_KEY=your-anthropic-api-key-here
FIGMA_DESIGN_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
FIGMA_DESIGN_ANTHROPIC_MAX_TOKENS=4096
# Optional: FIGMA_DESIGN_ANTHROPIC_TEMPERATURE=

# Google Gemini Configuration for Figma Design Agent
GEMINI_API_KEY=your-gemini-api-key-here
FIGMA_DESIGN_GEMINI_MODEL=gemini-1.5-pro
FIGMA_DESIGN_GEMINI_TEMPERATURE=0.7
# Optional: FIGMA_DESIGN_GEMINI_MAX_OUTPUT_TOKENS=

# ============================================
# Koog AI Agent Framework Configuration
# ============================================
KOOG_LLM_MODEL=gpt-4o-mini
KOOG_LLM_TEMPERATURE=0.7
KOOG_MAX_ITERATIONS=10

# ============================================
# REST Client Configuration
# ============================================
AI_SERVER_URL=http://localhost:8002

# ============================================
# Authentication Configuration - Figma OAuth
# ============================================
# Required for Figma OAuth authentication
AUTH_FIGMA_CLIENT_ID=your-figma-client-id-here
AUTH_FIGMA_CLIENT_SECRET=your-figma-client-secret-here

# ============================================
# Authentication Configuration - GitHub OAuth
# ============================================
# Required for GitHub OAuth authentication
AUTH_GITHUB_CLIENT_ID=your-github-client-id-here
AUTH_GITHUB_CLIENT_SECRET=your-github-client-secret-here

# ============================================
# Authentication Configuration - Auth0
# ============================================
# Resource-server JWT validation (multi-issuer alongside self-hosted JWTs).
# Leave AUTH0_ISSUER_URI unset to disable Auth0 entirely.
AUTH0_ISSUER_URI=https://your-tenant.eu.auth0.com/
AUTH0_AUDIENCE=https://api.penpot-ai.example
# AUTH0_JWK_SET_URI=  # Optional override; defaults to ${AUTH0_ISSUER_URI}/.well-known/jwks.json
#
# Auth0 as OAuth IdP for plugin login. Backend is a Regular Web Application in Auth0
# (confidential client; has client_secret). Set AUTH0_CLIENT_ID to enable /auth/auth0/*.
AUTH0_CLIENT_ID=your-auth0-client-id-here
AUTH0_CLIENT_SECRET=your-auth0-client-secret-here
AUTH0_LOGIN_REDIRECT_URI=http://localhost:8003/auth/auth0/callback
# AUTH0_REFRESH_TOKEN_LIFETIME_SEC=2592000  # Mirror your Auth0 refresh-token absolute lifetime

# ============================================
# Spring Profile Configuration
# ============================================
# Options: dev, prod, test
SPRING_PROFILES_ACTIVE=dev

# ============================================
# Profile Information
# ============================================
# This .env.dev file is only loaded when running with the 'dev' profile.
# To activate the dev profile, set:
#   spring.profiles.active=dev
# 
# For production, use actual environment variables instead of .env.dev files.
# Never commit real secrets to version control.
