# Example environment configuration for the Figma Plugin Companion App

# ==============================================
# Logging Configuration
# ==============================================

# Set the log level for the application
# Options: trace, debug, info, warn, error
# Default: info
RUST_LOG=info

# You can also set log levels per module:
# RUST_LOG=figma_plugin_companion_app::auth=debug,figma_plugin_companion_app::local_server=trace,info

# Example configurations for different scenarios:

# Development (verbose logging)
# RUST_LOG=debug

# Production (minimal logging)
# RUST_LOG=warn

# Debugging authentication issues
# RUST_LOG=figma_plugin_companion_app::auth=trace,info

# Debugging WebSocket issues
# RUST_LOG=figma_plugin_companion_app::local_server::ws_handlers=debug,info

# Debugging audio recording issues
# RUST_LOG=figma_plugin_companion_app::local_server::audio=debug,info

# ==============================================
# Application Configuration
# ==============================================

# Backend URL
VITE_BACKEND_URL=http://localhost:8080

# Application name
APP_NAME=figma_plugin_companion_app

# Keyring configuration
KEYRING_SERVICE=figma_plugin_companion_app
KEYRING_USERNAME=auth_credentials

# Command strings
EXPECTED_COMMAND_STRING=CMD
ACKNOWLEDGMENT_STRING=ACK

# Nonce validation window (in milliseconds)
# Default: 300000 (5 minutes)
NONCE_TIMESTAMP_WINDOW_MS=300000

# Audio sample rate (in Hz)
# Default: 16000
AUDIO_SAMPLE_RATE=16000
