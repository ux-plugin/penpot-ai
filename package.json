{
  "name": "figma_plugin_fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open dev.html",
    "build": "tsc -b && vite build && npm run bundle:prod",
    "bundle:prod": "esbuild --target=es2015 --format=iife src/widget/code.ts --bundle --outfile=dist/code.js --sourcemap --minify --tree-shaking=true",
    "build:debug": "VITE_ENABLE_BUILD_DEBUG=true tsc -b && VITE_ENABLE_BUILD_DEBUG=true vite build && VITE_ENABLE_BUILD_DEBUG=true npm run bundle:debug",
    "bundle:debug": "esbuild --target=es2015 --format=iife src/widget/code.ts --bundle --outfile=dist/code.js --sourcemap --tree-shaking=true",
    "preview": "vite preview",
    "build:watch": "watch 'npm run build' src",
    "cdn:publish": "./scripts/cdn-publish.sh",
    "cdn:build": "./scripts/publish-cdn.sh",
    "cdn:up": "./scripts/cdn-up.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@noble/ciphers": "^2.0.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/react": "^10.29.0",
    "@tailwindcss/vite": "^4.0.17",
    "@tanstack/react-query": "^5.83.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.537.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.7.1",
    "rsocket-composite-metadata": "^1.0.0-alpha.2",
    "rsocket-core": "^1.0.0-alpha.2",
    "rsocket-websocket-client": "^1.0.0-alpha.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-json-schema-generator": "^2.3.0",
    "tw-animate-css": "^1.3.6",
    "zustand": "^5.0.7",
    "penpot-exporter": "workspace:*",
    "skia-rs-wasm": "workspace:*",
    "figma-adapter": "workspace:*"
  },
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "^0.15.0",
    "@figma/plugin-typings": "^1.100.2",
    "@types/node": "^24.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "esbuild": "^0.25.10",
    "eslint": "^9.10.0",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "rollup-plugin-visualizer": "^6.0.5",
    "shadcn": "^2.10.0",
    "tailwindcss": "^4.0.17",
    "terser": "^5.44.0",
    "typescript": "^5.5.3",
    "vite": "6.3.4",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-plugin-singlefile": "^2.3.0",
