{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteRawOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::zoetrope-data/raw/*"
      ]
    },
    {
      "Sid": "ListBucketScoped",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::zoetrope-data"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["raw/*"]
        }
      }
    }
  ]
}
