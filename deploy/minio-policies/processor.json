{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAnonOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::zoetrope-data/anon/*"
      ]
    },
    {
      "Sid": "ListBucketScoped",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::zoetrope-data"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["anon/*"]
        }
      }
    }
  ]
}
