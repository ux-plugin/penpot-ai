{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawForClassification",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::zoetrope-data/raw/*"
      ]
    },
    {
      "Sid": "DeleteRawAfterEviction",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::zoetrope-data/raw/*"
      ]
    },
    {
      "Sid": "MoveToQuarantine",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::zoetrope-data/quarantine/*"
      ]
    },
    {
      "Sid": "ListBucketScoped",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::zoetrope-data"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["raw/*", "quarantine/*"]
        }
      }
    }
  ]
}
