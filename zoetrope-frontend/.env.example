# Auth0 SPA config — register a "Single Page Application" in your Auth0 tenant
# (separate from the Regular Web Application used by figma_plugin_api). The
# domain and audience must match figma_plugin_api/.env.dev so the access token
# this SPA mints is accepted as a bearer by the backend's JWT decoder.
VITE_AUTH0_DOMAIN=dev-wuncqr2eddi8qazn.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.zoetrope.com
