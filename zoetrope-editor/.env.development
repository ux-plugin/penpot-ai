# Dev server config (loaded by Vite in `vite` / serve mode).

# Font backend/proxy origin. Empty in dev: fonts are fetched directly from
# Google's CDN (fonts.gstatic.com), which serves the .ttf files with open CORS,
# so no proxy backend is needed locally.
VITE_FONT_BACKEND_URL=

# Build-mode AI chat — backend LLM-provider facade (platform key held server-side).
# baseURL: the AI SDK appends /chat/completions. Key: the API-key (pk_) credential.
VITE_AI_BACKEND_URL=http://localhost:8080/api/llm/v1
VITE_AI_BACKEND_KEY=
