# Copy to .env.local. The dev API key is seeded by the figma_plugin_api Liquibase
# changeset 'seed-dev-api-key' (db/changelog/0002-orgs-and-api-keys.sql).
VITE_DEV_API_KEY=pk_live_demo0000000000000000000000000000000000
# Backend base URL — leave empty when running via `pnpm dev` (Vite proxies /ingest
# and /api to localhost:8080). Override only if backend runs elsewhere.
VITE_API_BASE=
