# Database Configuration
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/figma_plugin
QUARKUS_DATASOURCE_USERNAME=postgres
QUARKUS_DATASOURCE_PASSWORD=postgres
QUARKUS_HIBERNATE_ORM_DATABASE_GENERATION=update

# Application Configuration
QUARKUS_HTTP_PORT=8080
QUARKUS_HTTP_HOST=0.0.0.0

# Logging
QUARKUS_LOG_LEVEL=INFO

# OpenAI Configuration (if needed)
# OPENAI_API_KEY=your-api-key-here

# BAML Configuration (if needed)
# BAML_API_KEY=your-baml-api-key

# Fireworks AI Configuration (for Whisper v3 Large transcription)
FIREWORKS_API_KEY=your-fireworks-api-key-here
