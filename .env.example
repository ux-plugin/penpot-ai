# Backend (required for login, RSocket, API). No trailing slash.
# Omit to run plugin without backend (UI loads; backend features show "not configured").
# VITE_BACKEND_URL=http://localhost:8003

# CDN base URL for WASM and worker assets (optional). No trailing slash.
# When set, the plugin loads render-wasm.js/.wasm and worker.js from this origin.
# For local dev without CDN, leave unset (relative paths; may not work in Figma iframe).
# VITE_CDN_URL=https://your-cdn.example.com

# Remote UI (non-null origin): URL where the plugin UI is served (e.g. nginx). No trailing slash.
# When set, build writes dist/redirect.html and dist/manifest.json with "ui": "redirect.html".
# Use that manifest when installing the plugin so the iframe redirects here (fixes worker load).
# VITE_PLUGIN_UI_URL=http://localhost:8082

# Plugin ID for postMessage when using non-null origin. Defaults to manifest.json "id" when unset.
# VITE_PLUGIN_ID=1412919504924588284

# Sentry Configuration
# Get your DSN from https://sentry.io/
# VITE_SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# Optional: Application version for release tracking
# VITE_APP_VERSION=1.0.0

# Debug Configuration
# Enable node debug info overlay showing dimensions, position, and data
# VITE_ENABLE_BUILD_DEBUG=true
