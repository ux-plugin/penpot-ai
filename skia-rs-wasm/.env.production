# Production build config (loaded by Vite in `vite build`).

# Self-hosted font backend/proxy origin. It replaces the gstatic origin
# (https://fonts.gstatic.com/s) in font URLs, so it must reverse-proxy that path
# to gstatic (mirrors Penpot's internal/gfonts/font proxy), e.g.:
#   VITE_FONT_BACKEND_URL=https://api.example.com/fonts
# Leave empty to fetch fonts directly from Google's CDN.
# Can also be overridden per-build: VITE_FONT_BACKEND_URL=… npm run build
VITE_FONT_BACKEND_URL=

# Build-mode AI chat — backend LLM-provider facade. Set to your deployed backend.
VITE_AI_BACKEND_URL=
VITE_AI_BACKEND_KEY=
